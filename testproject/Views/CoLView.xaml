<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="testproject.Views.CoLView"
             Title="CoLView">
    <ScrollView>
        <VerticalStackLayout>
            <CollectionView x:Name="MyCollectionView"
            ItemsSource="{Binding Songs}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                     Span="2"
                     HorizontalItemSpacing="8"
                     VerticalItemSpacing="8" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="Gray"
                                Padding="10"
                                Margin="0" >
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Image Source="{Binding Icon}"
                       Aspect="AspectFill"
                       HeightRequest="90"
                       WidthRequest="90"
                       HorizontalOptions="Center" />
                                <Label Text="{Binding Name}"
                       FontSize="16"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />
                                <Label Text="{Binding Artist}"
                       FontSize="13"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />

                                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                                    <Button Clicked="ShowSongInfo"
                                        Text="detailed information"
                                        FontSize="12"
                                        Padding="8,4" />

                                    <Button Text="Remove"
                                        FontSize="12"
                                        Padding="8,4"
                                        Command="{Binding Source={x:Reference MyCollectionView}, Path=BindingContext.RemoveSongCommand}"
                                        CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>